<Project>
    <!-- The samples build against a Turian checkout: a sibling of the bricks folder unless TurianDir is given. The
         library and its tests need none, but follow the engine's build settings when it is there. -->
    <PropertyGroup>
        <TurianDir Condition="'$(TurianDir)' == ''">$(MSBuildThisFileDirectory)../../../../Turian/</TurianDir>
        <TurianDir>$([MSBuild]::NormalizeDirectory('$(TurianDir)'))</TurianDir>
        <BrickDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</BrickDir>
    </PropertyGroup>

    <Import Project="$(TurianDir)Directory.Build.props" Condition="Exists('$(TurianDir)Directory.Build.props')"/>
</Project>
